+_Static_assert(
+    sizeof(fieldDomains) / sizeof(fieldDomains[0]) == ROTORLENS_BINDING_MANIFEST_ROW_COUNT,
+    "RotorLens binding manifest row count mismatch");
+_Static_assert(
+    sizeof(ROTORLENS_BINDING_MANIFEST_ID) - 1 == ROTORLENS_BINDING_MANIFEST_ID_LENGTH,
+    "RotorLens binding manifest identifier length mismatch");
+_Static_assert(
+    ROTORLENS_BINDING_MANIFEST_ROW_TLV_SIZE
+        == ROTORLENS_BINDING_MANIFEST_ROW_COUNT * 4
+            + ROTORLENS_BINDING_MANIFEST_VALUE_SIZE,
+    "RotorLens binding manifest encoded size mismatch");
+
+static uint8_t scalarWidth(uint8_t type)
+{
+    switch (type) {
+    case ROTORLENS_BINDING_SCALAR_BOOL:
+    case ROTORLENS_BINDING_SCALAR_U8:
+        return 1;
+    case ROTORLENS_BINDING_SCALAR_U16:
+    case ROTORLENS_BINDING_SCALAR_I16:
+        return 2;
+    default:
+        return 0;
+    }
+}
+
+static int32_t decodeScalar(const uint8_t *value, uint8_t type)
+{
+    if (type == ROTORLENS_BINDING_SCALAR_BOOL ||
+        type == ROTORLENS_BINDING_SCALAR_U8) {
+        return value[0];
+    }
+
+    const uint16_t raw = (uint16_t)((uint16_t)value[0] << 8) | value[1];
+    if (type == ROTORLENS_BINDING_SCALAR_I16 && (raw & 0x8000u) != 0) {
+        return (int32_t)raw - 65536;
+    }
+    return raw;
+}
+
