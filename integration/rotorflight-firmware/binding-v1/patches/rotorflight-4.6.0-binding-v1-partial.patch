+TEST(RotorlensBindingManifestUnittest, AcceptsLoadBearingScalarEndpoints)
+{
+    uint8_t values[sizeof(canonicalValues)];
+    memcpy(values, canonicalValues, sizeof(values));
+
+    values[0] = 6;       // rates_type maximum
+    values[1] = 1;       // roll_rc_rate minimum
+    values[2] = 100;     // roll_expo maximum
+    values[3] = 100;     // Rotorflight srate limit
+    setScalarBe(values, 4, 2, 0);
+    values[6] = 0;
+    values[7] = 200;
+    values[8] = 0;
+    values[9] = 100;
+    setScalarBe(values, 10, 2, 50000);
+    values[12] = 250;
+    values[13] = 200;
+    values[14] = 100;
+    values[15] = 100;
+    values[19] = 255;    // Collective is not rate-type clamped in RF 4.6.
+    values[20] = 100;
+    values[21] = 255;
+    values[28] = 0;      // Full-domain u8 endpoints.
+    values[29] = 255;
+    values[40] = 1;
+    values[41] = 4;
+    values[42] = 2;
+    setScalarBe(values, 43, 2, 0);
+    setScalarBe(values, 45, 2, 600);
+    values[53] = 0;
+    values[54] = 250;
+    values[55] = 100;
+    values[56] = 0;
+    values[57] = 250;
+    values[67] = 0;
+    values[71] = 250;
+    values[72] = 0;
+    values[75] = 1;
+    setScalarBe(values, 76, 2, 50000);
+    values[78] = 0;
+    values[82] = 250;
+    values[83] = 0;
+    values[86] = 100;
+    values[87] = 0;
+    values[91] = 250;
+    values[92] = 100;
+    values[93] = 10;
+    values[94] = 50;
+    values[95] = 40;
+    values[96] = 100;
+    setScalarBe(values, 97, 2, -2500);
+    setScalarBe(values, 99, 2, 2500);
+    setScalarBe(values, 101, 2, 10000);
+
+    expectAcceptedWithoutMutation(values);
+}
+
+TEST(RotorlensBindingManifestUnittest, EnforcesRateTypeLimitsForEveryCyclicAxis)
+{
+    static const uint8_t limits[][2] = {
+        { 255, 90 },
+        { 200, 255 },
+        { 255, 90 },
+        { 200, 200 },
+        { 255, 200 },
+        { 200, 100 },
+    };
+    static const size_t axisOffsets[] = { 1, 7, 13 };
+
+    for (unsigned ratesType = 1; ratesType <= 6; ratesType++) {
+        for (size_t axis = 0; axis < sizeof(axisOffsets) / sizeof(axisOffsets[0]); axis++) {
+            SCOPED_TRACE(ratesType);
+            SCOPED_TRACE(axis);
+            uint8_t values[sizeof(canonicalValues)];
+            memcpy(values, canonicalValues, sizeof(values));
+            values[0] = (uint8_t)ratesType;
+            for (size_t resetAxis = 0;
+                 resetAxis < sizeof(axisOffsets) / sizeof(axisOffsets[0]);
+                 resetAxis++) {
+                values[axisOffsets[resetAxis]] = 1;
+                values[axisOffsets[resetAxis] + 1] = 0;
+                values[axisOffsets[resetAxis] + 2] = 0;
+            }
+
+            const size_t offset = axisOffsets[axis];
+            values[offset] = limits[ratesType - 1][0];
+            values[offset + 1] = 100;
+            values[offset + 2] = limits[ratesType - 1][1];
+            expectAcceptedWithoutMutation(values);
+
+            if (limits[ratesType - 1][0] < 255) {
+                values[offset]++;
+                expectRejectedBeforeWriting(values);
+                values[offset]--;
+            }
+            if (limits[ratesType - 1][1] < 255) {
+                values[offset + 2]++;
+                expectRejectedBeforeWriting(values);
+            }
+        }
+    }
+}
+
+TEST(RotorlensBindingManifestUnittest, EnforcesGovernorConfigCrossFields)
+{
+    uint8_t values[sizeof(canonicalValues)];
+
+    for (uint8_t mode = 0; mode < 3; mode++) {
+        SCOPED_TRACE(mode);
+        memcpy(values, canonicalValues, sizeof(values));
+        values[41] = mode;
+        values[42] = 1;
+        if (mode != 0) {
+            memset(values + 72, 0, 4);
+        }
+        expectRejectedBeforeWriting(values);
+    }
+
+    for (uint8_t mode = 3; mode <= 4; mode++) {
+        SCOPED_TRACE(mode);
+        memcpy(values, canonicalValues, sizeof(values));
+        values[41] = mode;
+        values[42] = 1;
+        expectAcceptedWithoutMutation(values);
+    }
+
+    memcpy(values, canonicalValues, sizeof(values));
+    values[56] = 100;
+    values[57] = 99;
+    expectRejectedBeforeWriting(values);
+
+    memcpy(values, canonicalValues, sizeof(values));
+    values[55] = 10;
+    values[56] = 0;
+    values[57] = 100;
+    expectRejectedBeforeWriting(values);
+    values[56] = 99;
+    values[57] = 99;
+    expectAcceptedWithoutMutation(values);
+
+    values[55] = 26;
+    values[56] = 250;
+    values[57] = 250;
+    expectAcceptedWithoutMutation(values);
+}
+
+TEST(RotorlensBindingManifestUnittest, PreservesGovernorModeOffProfileNuance)
+{
+    for (uint8_t mode = 0; mode <= 4; mode++) {
+        SCOPED_TRACE(mode);
+        uint8_t values[sizeof(canonicalValues)];
+        memcpy(values, canonicalValues, sizeof(values));
+        values[41] = mode;
+        values[42] = 0;
+        memset(values + 72, 1, 4);
+        values[55] = 100;
+        values[92] = 10;
+        values[93] = 100;
+
+        if (mode == 0) {
+            expectAcceptedWithoutMutation(values);
+        } else {
+            expectRejectedBeforeWriting(values);
+        }
+    }
+
+    for (uint8_t mode = 1; mode <= 2; mode++) {
+        for (size_t flagOffset = 72; flagOffset <= 75; flagOffset++) {
+            SCOPED_TRACE(mode);
+            SCOPED_TRACE(flagOffset);
+            uint8_t values[sizeof(canonicalValues)];
+            memcpy(values, canonicalValues, sizeof(values));
+            values[41] = mode;
+            values[42] = 0;
+            memset(values + 72, 0, 4);
+            values[55] = 50;
+            values[92] = 50;
+            values[93] = 50;
+            values[flagOffset] = 1;
+            expectRejectedBeforeWriting(values);
+            values[flagOffset] = 0;
+            expectAcceptedWithoutMutation(values);
+        }
+    }
+
+    for (uint8_t mode = 3; mode <= 4; mode++) {
+        SCOPED_TRACE(mode);
+        uint8_t values[sizeof(canonicalValues)];
+        memcpy(values, canonicalValues, sizeof(values));
+        values[41] = mode;
+        memset(values + 72, 1, 4);
+        values[55] = 50;
+        values[92] = 50;
+        values[93] = 50;
+        expectAcceptedWithoutMutation(values);
+    }
+
+    for (uint8_t mode = 1; mode <= 4; mode++) {
+        SCOPED_TRACE(mode);
+        uint8_t values[sizeof(canonicalValues)];
+        memcpy(values, canonicalValues, sizeof(values));
+        values[41] = mode;
+        values[42] = 0;
+        memset(values + 72, 0, 4);
+        values[55] = 100;
+        values[92] = 99;
+        values[93] = 10;
+        expectRejectedBeforeWriting(values);
+
+        values[55] = 50;
+        values[92] = 50;
+        values[93] = 51;
+        expectRejectedBeforeWriting(values);
+    }
+}
+
+TEST(RotorlensBindingManifestUnittest, EnforcesSignedMixerBoundsAndOrdering)
+{
+    uint8_t values[sizeof(canonicalValues)];
+    memcpy(values, canonicalValues, sizeof(values));
+    setScalarBe(values, 97, 2, -2500);
+    setScalarBe(values, 99, 2, 2500);
+    setScalarBe(values, 101, 2, -10000);
+    expectAcceptedWithoutMutation(values);
+
+    setScalarBe(values, 101, 2, 10000);
+    expectAcceptedWithoutMutation(values);
+
+    setScalarBe(values, 97, 2, 2500);
+    setScalarBe(values, 99, 2, 2499);
+    expectRejectedBeforeWriting(values);
+}
+
+TEST(RotorlensBindingManifestUnittest, RejectsSemanticValuesBeforeWriting)
+{
+    uint8_t invalidValues[sizeof(canonicalValues)];
+    memcpy(invalidValues, canonicalValues, sizeof(invalidValues));
+    invalidValues[0] = 0xff;
+
+    countWriterState_t writerState = {};
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_INVALID_VALUE,
+        rotorlensBindingManifestEncodeRowsV1(
+            invalidValues, sizeof(invalidValues), countWriter, &writerState));
+    EXPECT_EQ(0u, writerState.callCount);
+    EXPECT_EQ(0u, writerState.acceptedLength);
+}
+
+TEST(RotorlensBindingManifestUnittest, WriterFailureRequiresDiscardingPartialSink)
+{
+    hashWriterState_t writerState = {};
+    writerState.failCall = 45;
+    sha256Init(&writerState.sha256);
+
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_WRITE_FAILED,
+        rotorlensBindingManifestEncodeRowsV1(
+            canonicalValues, sizeof(canonicalValues), hashWriter, &writerState));
+    EXPECT_EQ(45u, writerState.callCount);
+    EXPECT_GT(writerState.acceptedLength, 0u);
+    EXPECT_LT(writerState.acceptedLength, ROTORLENS_BINDING_MANIFEST_ROW_TLV_SIZE);
+}
