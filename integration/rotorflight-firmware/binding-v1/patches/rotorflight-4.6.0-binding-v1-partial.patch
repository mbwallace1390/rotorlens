+    FIELD_DOMAIN_BOOL,
+    FIELD_DOMAIN_RATES_TYPE,
+    FIELD_DOMAIN_U8_1_255,
+    FIELD_DOMAIN_U8_0_100,
+    FIELD_DOMAIN_U8_0_255,
