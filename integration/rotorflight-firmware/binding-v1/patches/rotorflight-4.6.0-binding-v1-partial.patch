--- /dev/null
+++ b/src/main/config/rotorlens_config_mutation_epoch.h
@@ -0,0 +1,67 @@
+/*
+ * This file is part of Rotorflight.
+ *
+ * Rotorflight is free software. You can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Rotorflight is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this software. If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define ROTORLENS_CONFIG_MUTATION_EPOCH_FAULT UINT32_MAX
+
+/*
+ * Mark the task-context boundary around one configuration mutation. Calls may
+ * nest. The outer begin changes the generation from even to odd; the outer end
+ * changes it to the next even value. Even a no-op mutation therefore advances
+ * the generation by two and cannot be mistaken for an unchanged snapshot.
+ *
+ * Calling either function from interrupt context, ending without a matching
+ * begin, overflowing the nesting depth, or exhausting the generation latches
+ * ROTORLENS_CONFIG_MUTATION_EPOCH_FAULT permanently. False means the fault is
+ * latched. A fault disables RotorLens trusted capture, but must not abort,
+ * roll back, or otherwise change the user's normal configuration mutation.
+ *
+ * This Phase 2H-A primitive is intentionally not connected to configuration
+ * writers, capture, MSP, CLI, UI, or runtime acceptance yet.
+ */
+bool rotorlensConfigMutationEpochBegin(void);
+bool rotorlensConfigMutationEpochEnd(void);
+
+/*
+ * Return one aligned 32-bit generation sample. An even value is stable, an odd
+ * value has an active mutation, and UINT32_MAX is the permanent fault sentinel.
+ * A later capture layer must sample before and after copying and accept only
+ * identical, even, non-fault values after every relevant production writer is
+ * covered. In particular, generation zero proves nothing while this primitive
+ * has no production hooks. This function alone proves no snapshot.
+ */
+uint32_t rotorlensConfigMutationEpochGeneration(void);
+
+#if defined(UNIT_TEST)
+/* Host-only controls expose boundary states without production recovery APIs. */
+void rotorlensConfigMutationEpochTestReset(void);
+void rotorlensConfigMutationEpochTestSeed(uint32_t generation, uint16_t depth);
+void rotorlensConfigMutationEpochTestSetInterruptContext(bool active);
+void rotorlensConfigMutationEpochTestInjectInterruptFaultAfterStateRead(void);
+void rotorlensConfigMutationEpochTestSetPrimask(bool disabled);
+bool rotorlensConfigMutationEpochTestPrimask(void);
+uint16_t rotorlensConfigMutationEpochTestDepth(void);
+void rotorlensConfigMutationEpochTestClearInstrumentation(void);
+uint32_t rotorlensConfigMutationEpochTestBarrierCount(void);
