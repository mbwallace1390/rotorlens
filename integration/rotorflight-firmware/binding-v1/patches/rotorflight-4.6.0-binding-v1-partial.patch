+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define ROTORLENS_BINDING_MANIFEST_ID                 "rotorlens-rf460-config-r1"
+#define ROTORLENS_BINDING_MANIFEST_ID_LENGTH          25
+#define ROTORLENS_BINDING_MANIFEST_ROW_COUNT          90
+#define ROTORLENS_BINDING_MANIFEST_VALUE_SIZE         103
+#define ROTORLENS_BINDING_MANIFEST_ROW_TLV_SIZE       463
+#define ROTORLENS_BINDING_MANIFEST_MAX_ROW_WRITE_SIZE 6
+
+typedef enum {
+    ROTORLENS_BINDING_SCALAR_BOOL = 1,
+    ROTORLENS_BINDING_SCALAR_U8 = 2,
+    ROTORLENS_BINDING_SCALAR_U16 = 3,
+    ROTORLENS_BINDING_SCALAR_I16 = 5,
+} rotorlensBindingScalarType_e;
+
+typedef enum {
+    ROTORLENS_BINDING_MANIFEST_OK = 0,
+    ROTORLENS_BINDING_MANIFEST_INVALID_ARGUMENT,
+    ROTORLENS_BINDING_MANIFEST_INVALID_LENGTH,
+    ROTORLENS_BINDING_MANIFEST_INVALID_VALUE,
+    ROTORLENS_BINDING_MANIFEST_WRITE_FAILED,
+} rotorlensBindingManifestResult_e;
+
+typedef bool (*rotorlensBindingManifestWriterFn)(
+    void *context, const uint8_t *data, size_t length);
+
+/*
+ * Validate, then encode an immutable canonical-value snapshot as binding-v1
+ * row TLVs. Values are concatenated in field-id order and 16-bit values are
+ * big-endian. Validation is fail-closed over the exact byte length, every
+ * scalar domain, and the deterministic source-reviewed cross-field safe
+ * allowlist. Semantic rejection occurs before the writer is called.
+ *
+ * This function does not read live configuration or prove capture origin,
+ * atomicity, target identity, or runtime-effective governor state. A future
+ * capture layer remains responsible for those properties and must keep the
+ * snapshot immutable until this function returns.
+ *
+ * The writer receives one complete row of at most
+ * ROTORLENS_BINDING_MANIFEST_MAX_ROW_WRITE_SIZE bytes and must synchronously
+ * consume or copy it before returning. A writer failure can leave a partial
+ * sink; callers must discard the entire sink unless this function returns
+ * ROTORLENS_BINDING_MANIFEST_OK.
+ */
+rotorlensBindingManifestResult_e rotorlensBindingManifestEncodeRowsV1(
+    const uint8_t *values,
+    size_t valueLength,
+    rotorlensBindingManifestWriterFn writer,
+    void *writerContext);
diff --git a/src/main/config/rotorlens_config_mutation_epoch.c b/src/main/config/rotorlens_config_mutation_epoch.c
new file mode 100644
index 0000000000000000000000000000000000000000..edbeff8a1c76196521d269e37523a0257c262a49
--- /dev/null
+++ b/src/main/config/rotorlens_config_mutation_epoch.c
@@ -0,0 +1,364 @@
+/*
+ * This file is part of Rotorflight.
+ *
+ * Rotorflight is free software. You can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Rotorflight is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this software. If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "platform.h"
+
+#include <limits.h>
+
+#include "config/rotorlens_config_mutation_epoch.h"
+
+typedef struct rotorlensConfigMutationEpochState_s {
+    volatile uint32_t generation;
+    volatile uint16_t depth;
+    volatile uint16_t faultLatched;
+} rotorlensConfigMutationEpochState_t;
+
+_Static_assert(sizeof(rotorlensConfigMutationEpochState_t) == 8,
+    "RotorLens mutation epoch state must remain eight bytes");
+
+/* Zero initialization is the first stable generation with no active writer. */
+static rotorlensConfigMutationEpochState_t epochState;
+
+#if defined(UNIT_TEST)
+static uint32_t testInterruptContext;
+static uint32_t testPrimask;
+static bool testInjectInterruptFaultAfterStateRead;
+static uint32_t testBarrierCount;
+static uint32_t testStateWriteCount;
+static bool testCriticalSectionActive;
+static bool testHadUnprotectedStateWrite;
+static bool testLastStateWriteWasPublished;
+#endif
+
+static inline void compilerBarrier(void)
+{
+    __asm__ volatile ("" ::: "memory");
+}
+
+static inline void publicationBarrier(void)
+{
+    compilerBarrier();
+#if defined(UNIT_TEST)
+    /* Make host tests observe publication points without emulating a CPU DMB. */
+    testBarrierCount++;
+    testLastStateWriteWasPublished = true;
+#elif defined(SIMULATOR_BUILD)
+    /* The simulator has no CMSIS DMB intrinsic but still needs a host fence. */
+    __sync_synchronize();
+#else
+    __DMB();
+#endif
+    compilerBarrier();
+}
+
+static inline bool calledFromInterrupt(void)
+{
+#if defined(UNIT_TEST)
+    return testInterruptContext != 0;
+#elif defined(SIMULATOR_BUILD)
+    /* Compile-only shim: worker context is not detectable; there are no callers. */
+    return false;
+#else
+    return __get_IPSR() != 0;
+#endif
+}
+
+static uint32_t enterCriticalSection(void)
+{
+#if defined(UNIT_TEST)
+    const uint32_t savedPrimask = testPrimask;
+    /* Model PRIMASK=1 while the state pair is updated. */
+    testPrimask = 1;
+    testCriticalSectionActive = true;
+#elif defined(SIMULATOR_BUILD)
+    /* Compile-only shim: not a SITL mutex or trusted-capture guard. */
+    const uint32_t savedPrimask = 0;
+#else
+    const uint32_t savedPrimask = __get_PRIMASK();
+    __disable_irq();
+#endif
+    compilerBarrier();
+    return savedPrimask;
+}
+
+static void leaveCriticalSection(uint32_t savedPrimask)
+{
+    compilerBarrier();
+#if defined(UNIT_TEST)
+    testCriticalSectionActive = false;
+    /* Restore the caller's exact simulated interrupt-mask state. */
+    testPrimask = savedPrimask;
+#elif defined(SIMULATOR_BUILD)
+    (void)savedPrimask;
+#else
+    __set_PRIMASK(savedPrimask);
+#endif
+}
+
+static void writeGenerationLocked(uint32_t generation)
+{
+#if defined(UNIT_TEST)
+    testStateWriteCount++;
+    testLastStateWriteWasPublished = false;
+    if (!testCriticalSectionActive || testPrimask == 0) {
+        testHadUnprotectedStateWrite = true;
+    }
+#endif
+    /* Publish one aligned generation word while interrupts are masked. */
+    epochState.generation = generation;
+}
+
+static void writeDepthLocked(uint16_t depth)
+{
+#if defined(UNIT_TEST)
+    testStateWriteCount++;
+    testLastStateWriteWasPublished = false;
+    if (!testCriticalSectionActive || testPrimask == 0) {
+        testHadUnprotectedStateWrite = true;
+    }
+#endif
+    /* Publish the matching nested depth while interrupts are masked. */
+    epochState.depth = depth;
+}
+
+static void writeFaultLocked(void)
+{
+#if defined(UNIT_TEST)
+    testStateWriteCount++;
+    testLastStateWriteWasPublished = false;
+    if (!testCriticalSectionActive || testPrimask == 0) {
+        testHadUnprotectedStateWrite = true;
+    }
+#endif
+    /* Only host reset may clear this sticky NMI/HardFault-safe poison bit. */
+    epochState.faultLatched = 1u;
+}
+
+static void latchFaultLocked(void)
+{
+    /* Latch first so stale writes interrupted by NMI cannot erase the fault. */
+    writeFaultLocked();
+    /* The sentinel is never advanced or reset by a production API. */
+    writeGenerationLocked(ROTORLENS_CONFIG_MUTATION_EPOCH_FAULT);
+    /* Drop depth so a corrupted active state cannot appear recoverable. */
+    writeDepthLocked(0);
+}
+
+static void latchFault(void)
+{
+    const uint32_t savedPrimask = enterCriticalSection();
+    latchFaultLocked();
+    publicationBarrier();
+    leaveCriticalSection(savedPrimask);
+}
+
+static bool stateShapeIsValid(uint32_t generation, uint16_t depth)
+{
+    const bool generationIsOdd = (generation & 1u) != 0;
+    return generation != ROTORLENS_CONFIG_MUTATION_EPOCH_FAULT &&
+        ((depth == 0) != generationIsOdd);
+}
+
+#if defined(UNIT_TEST)
+static void injectInterruptFaultAfterStateRead(void)
+{
+    if (testInjectInterruptFaultAfterStateRead) {
+        /* Model an NMI latching fault after the task cached generation/depth. */
+        testInjectInterruptFaultAfterStateRead = false;
+        latchFaultLocked();
+        publicationBarrier();
+    }
+}
+#endif
+
+bool rotorlensConfigMutationEpochBegin(void)
+{
+    if (calledFromInterrupt()) {
+        latchFault();
+        return false;
+    }
+
+    const uint32_t savedPrimask = enterCriticalSection();
+    const uint32_t generation = epochState.generation;
+    const uint16_t depth = epochState.depth;
+
+    if (epochState.faultLatched != 0 ||
+        !stateShapeIsValid(generation, depth) ||
+        depth == UINT16_MAX ||
+        (depth == 0 && generation == UINT32_MAX - 1u)) {
+        latchFaultLocked();
+        publicationBarrier();
+        leaveCriticalSection(savedPrimask);
+        return false;
+    }
+
+#if defined(UNIT_TEST)
+    injectInterruptFaultAfterStateRead();
+#endif
+
+    if (depth == 0) {
+        /* Publish an odd generation before any outer mutation can execute. */
+        writeGenerationLocked(generation + 1u);
+    }
+    /* Record this matching begin after validating the 16-bit depth bound. */
+    writeDepthLocked((uint16_t)(depth + 1u));
+
+    publicationBarrier();
+    if (epochState.faultLatched != 0) {
+        /* Normalize stale task writes while retaining the sticky fault bit. */
+        latchFaultLocked();
+        publicationBarrier();
+        leaveCriticalSection(savedPrimask);
+        return false;
+    }
+    leaveCriticalSection(savedPrimask);
+    return true;
+}
+
+bool rotorlensConfigMutationEpochEnd(void)
+{
+    if (calledFromInterrupt()) {
+        latchFault();
+        return false;
+    }
+
+    /* Complete prior configuration stores before an outer end becomes stable. */
+    publicationBarrier();
+
+    const uint32_t savedPrimask = enterCriticalSection();
+    const uint32_t generation = epochState.generation;
+    const uint16_t depth = epochState.depth;
+
+    if (epochState.faultLatched != 0 ||
+        !stateShapeIsValid(generation, depth) || depth == 0) {
+        latchFaultLocked();
+        publicationBarrier();
+        leaveCriticalSection(savedPrimask);
+        return false;
+    }
+
+#if defined(UNIT_TEST)
+    injectInterruptFaultAfterStateRead();
+#endif
+
+    /* Consume exactly one matching begin. */
+    writeDepthLocked((uint16_t)(depth - 1u));
+    if (depth == 1) {
+        /* Publish the next even generation only when the outer mutation ends. */
+        writeGenerationLocked(generation + 1u);
+    }
+
+    publicationBarrier();
+    if (epochState.faultLatched != 0) {
+        /* Normalize stale task writes while retaining the sticky fault bit. */
+        latchFaultLocked();
+        publicationBarrier();
+        leaveCriticalSection(savedPrimask);
+        return false;
+    }
+    leaveCriticalSection(savedPrimask);
+    return true;
+}
+
+uint32_t rotorlensConfigMutationEpochGeneration(void)
+{
+    publicationBarrier();
+    const uint16_t faultBefore = epochState.faultLatched;
+    const uint32_t generation = epochState.generation;
+    const uint16_t faultAfter = epochState.faultLatched;
+    publicationBarrier();
+    return (faultBefore != 0 || faultAfter != 0)
+        ? ROTORLENS_CONFIG_MUTATION_EPOCH_FAULT
+        : generation;
+}
+
+#if defined(UNIT_TEST)
+void rotorlensConfigMutationEpochTestReset(void)
+{
+    /* Restore the only production initial state plus a task-context host. */
+    epochState.generation = 0;
+    epochState.depth = 0;
+    epochState.faultLatched = 0;
+    testInterruptContext = 0;
+    testPrimask = 0;
+    testInjectInterruptFaultAfterStateRead = false;
+    rotorlensConfigMutationEpochTestClearInstrumentation();
+}
+
+void rotorlensConfigMutationEpochTestSeed(uint32_t generation, uint16_t depth)
+{
+    /* Tests may inject valid boundaries and impossible corrupted state shapes. */
+    epochState.generation = generation;
+    epochState.depth = depth;
+}
+
+void rotorlensConfigMutationEpochTestSetInterruptContext(bool active)
+{
+    /* Model IPSR=1 for interrupt context and IPSR=0 for task context. */
+    testInterruptContext = active ? 1u : 0u;
+}
+
+void rotorlensConfigMutationEpochTestInjectInterruptFaultAfterStateRead(void)
+{
+    testInjectInterruptFaultAfterStateRead = true;
+}
+
+void rotorlensConfigMutationEpochTestSetPrimask(bool disabled)
+{
+    /* Model the caller's incoming PRIMASK bit. */
+    testPrimask = disabled ? 1u : 0u;
+}
+
+bool rotorlensConfigMutationEpochTestPrimask(void)
+{
+    return testPrimask != 0;
+}
+
+uint16_t rotorlensConfigMutationEpochTestDepth(void)
+{
+    return epochState.depth;
+}
+
+void rotorlensConfigMutationEpochTestClearInstrumentation(void)
+{
+    testBarrierCount = 0;
+    testStateWriteCount = 0;
+    testCriticalSectionActive = false;
+    testHadUnprotectedStateWrite = false;
+    testLastStateWriteWasPublished = true;
+}
+
+uint32_t rotorlensConfigMutationEpochTestBarrierCount(void)
+{
+    return testBarrierCount;
+}
+
+uint32_t rotorlensConfigMutationEpochTestStateWriteCount(void)
+{
+    return testStateWriteCount;
+}
+
+bool rotorlensConfigMutationEpochTestHadUnprotectedStateWrite(void)
+{
+    return testHadUnprotectedStateWrite;
+}
+
+bool rotorlensConfigMutationEpochTestLastStateWriteWasPublished(void)
+{
+    return testLastStateWriteWasPublished;
+}
+#endif
