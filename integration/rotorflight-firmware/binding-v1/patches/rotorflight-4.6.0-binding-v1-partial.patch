+
+static void expectDigestEquals(
+    const uint8_t expected[SHA256_DIGEST_SIZE],
+    const uint8_t actual[SHA256_DIGEST_SIZE])
+{
+    for (unsigned i = 0; i < SHA256_DIGEST_SIZE; i++) {
+        EXPECT_EQ(expected[i], actual[i]) << "digest byte " << i;
+    }
+}
+
+TEST(Sha256Unittest, NistVectors)
+{
+    static const uint8_t emptyExpected[SHA256_DIGEST_SIZE] = {
+        0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
+        0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
+        0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
+        0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55,
+    };
+    static const uint8_t abcExpected[SHA256_DIGEST_SIZE] = {
+        0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
+        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
+        0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
+        0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad,
+    };
+    static const uint8_t abc[] = { 'a', 'b', 'c' };
+
+    sha256Context_t context;
+    uint8_t digest[SHA256_DIGEST_SIZE];
+
+    sha256Init(&context);
+    sha256Final(&context, digest);
+    expectDigestEquals(emptyExpected, digest);
+
+    sha256Init(&context);
+    sha256Update(&context, abc, sizeof(abc));
+    sha256Final(&context, digest);
+    expectDigestEquals(abcExpected, digest);
+}
+
+TEST(Sha256Unittest, ZeroLengthNullUpdatePreservesPartialState)
+{
+    static const uint8_t expected[SHA256_DIGEST_SIZE] = {
+        0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
+        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
+        0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
+        0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad,
+    };
+    static const uint8_t first[] = { 'a' };
+    static const uint8_t remainder[] = { 'b', 'c' };
+
+    sha256Context_t context;
+    sha256Init(&context);
+    sha256Update(&context, first, sizeof(first));
+    sha256Update(&context, nullptr, 0);
+    sha256Update(&context, remainder, sizeof(remainder));
+
+    uint8_t digest[SHA256_DIGEST_SIZE];
+    sha256Final(&context, digest);
+    expectDigestEquals(expected, digest);
+}
+
+TEST(Sha256Unittest, PaddingBoundariesAreChunkInvariant)
+{
+    struct boundaryVector_t {
+        size_t length;
