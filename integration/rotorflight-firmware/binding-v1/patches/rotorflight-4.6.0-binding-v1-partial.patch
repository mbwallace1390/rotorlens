+    FIELD_DOMAIN_U8_5_40,
+    FIELD_DOMAIN_I16_NEG2500_2500,
+    FIELD_DOMAIN_I16_NEG10000_10000,
+    FIELD_DOMAIN_COUNT,
+} fieldDomainId_e;
+
+typedef struct fieldDomain_s {
+    int16_t minimum;
+    uint16_t maximum;
+    uint8_t type;
+} fieldDomain_t;
