+static const uint8_t rowTlvDigest[SHA256_DIGEST_SIZE] = {
+    0xef, 0x45, 0x5b, 0xc8, 0xfa, 0x3f, 0x66, 0xb7,
+    0xbf, 0xf2, 0x8a, 0xa1, 0x68, 0x99, 0xce, 0x97,
+    0x44, 0x04, 0x90, 0x06, 0xde, 0xda, 0x02, 0x13,
+    0x71, 0xf2, 0x34, 0xd8, 0xf1, 0x43, 0xfc, 0x39,
+};
+
+static void expectDigestEquals(
+    const uint8_t expected[SHA256_DIGEST_SIZE],
+    const uint8_t actual[SHA256_DIGEST_SIZE])
+{
+    for (unsigned i = 0; i < SHA256_DIGEST_SIZE; i++) {
+        EXPECT_EQ(expected[i], actual[i]) << "digest byte " << i;
+    }
+}
+
+typedef struct hashWriterState_s {
+    sha256Context_t sha256;
+    size_t acceptedLength;
+    size_t maximumWriteLength;
+    unsigned callCount;
+    unsigned failCall;
+    uint8_t firstRow[ROTORLENS_BINDING_MANIFEST_MAX_ROW_WRITE_SIZE];
+    size_t firstRowLength;
+    uint8_t lastRow[ROTORLENS_BINDING_MANIFEST_MAX_ROW_WRITE_SIZE];
+    size_t lastRowLength;
+} hashWriterState_t;
+
+static bool hashWriter(void *context, const uint8_t *data, size_t length)
+{
+    hashWriterState_t *state = (hashWriterState_t *)context;
+    state->callCount++;
+    if (state->failCall != 0 && state->callCount == state->failCall) {
+        return false;
+    }
+
+    if (length > state->maximumWriteLength) {
+        state->maximumWriteLength = length;
+    }
+    if (state->firstRowLength == 0) {
+        memcpy(state->firstRow, data, length);
+        state->firstRowLength = length;
+    }
+    memcpy(state->lastRow, data, length);
+    state->lastRowLength = length;
+    sha256Update(&state->sha256, data, length);
+    state->acceptedLength += length;
+    return true;
+}
+
+typedef struct countWriterState_s {
+    unsigned callCount;
+    size_t acceptedLength;
+} countWriterState_t;
+
+static bool countWriter(void *context, const uint8_t *, size_t length)
+{
+    countWriterState_t *state = (countWriterState_t *)context;
+    state->callCount++;
+    state->acceptedLength += length;
+    return true;
+}
+
+static void setScalarBe(uint8_t *values, size_t offset, uint8_t width, int32_t value)
+{
+    if (width == 1) {
+        values[offset] = (uint8_t)value;
+        return;
+    }
+
+    const uint16_t encoded = (uint16_t)value;
+    values[offset] = (uint8_t)(encoded >> 8);
+    values[offset + 1] = (uint8_t)encoded;
+}
+
+static void prepareScalarOracleValues(uint8_t *values, unsigned fieldId)
+{
+    static const size_t cyclicAxisOffsets[] = { 1, 7, 13 };
+    memcpy(values, canonicalValues, sizeof(canonicalValues));
+
+    /* Keep all unrelated cyclic fields valid under the selected rate type. */
+    values[0] = 1;
+    for (size_t index = 0;
+         index < sizeof(cyclicAxisOffsets) / sizeof(cyclicAxisOffsets[0]);
+         index++) {
+        values[cyclicAxisOffsets[index]] = 1;
+        values[cyclicAxisOffsets[index] + 1] = 0;
+        values[cyclicAxisOffsets[index] + 2] = 0;
+    }
+    if (fieldId == 4 || fieldId == 9 || fieldId == 14) {
+        values[0] = 2; // Raceflight permits the full u8 cyclic srate domain.
+    }
+
+    /* Mode OFF isolates governor scalar domains from profile cross-rules. */
+    values[41] = 0;
+    values[42] = 0;
+    values[55] = 10;
+    values[56] = 0;
+    values[57] = 0;
+    memset(values + 72, 0, 4);
+    values[92] = 100;
+    values[93] = 10;
+    if (fieldId == 48) {
+        values[55] = 26;
+        values[57] = 250;
+    } else if (fieldId == 49) {
+        values[55] = 26;
+    }
+
+    /* Either signed collective endpoint remains valid when varied alone. */
+    setScalarBe(values, 97, 2, -2500);
+    setScalarBe(values, 99, 2, 2500);
+    setScalarBe(values, 101, 2, 0);
+}
+
+static void expectRejectedBeforeWriting(const uint8_t *values)
+{
+    uint8_t before[sizeof(canonicalValues)];
+    memcpy(before, values, sizeof(before));
+    countWriterState_t writerState = {};
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_INVALID_VALUE,
+        rotorlensBindingManifestEncodeRowsV1(
+            values, sizeof(canonicalValues), countWriter, &writerState));
+    EXPECT_EQ(0u, writerState.callCount);
+    EXPECT_EQ(0u, writerState.acceptedLength);
+    EXPECT_EQ(0, memcmp(before, values, sizeof(before)));
+}
+
+static void expectAcceptedWithoutMutation(const uint8_t *values)
+{
+    uint8_t before[sizeof(canonicalValues)];
+    memcpy(before, values, sizeof(before));
+    countWriterState_t writerState = {};
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_OK,
+        rotorlensBindingManifestEncodeRowsV1(
+            values, sizeof(canonicalValues), countWriter, &writerState));
+    EXPECT_EQ(ROTORLENS_BINDING_MANIFEST_ROW_COUNT, writerState.callCount);
+    EXPECT_EQ(ROTORLENS_BINDING_MANIFEST_ROW_TLV_SIZE, writerState.acceptedLength);
+    EXPECT_EQ(0, memcmp(before, values, sizeof(before)));
+}
+
+TEST(RotorlensBindingManifestUnittest, EncodesIndependentNinetyRowVector)
+{
+    EXPECT_STREQ("rotorlens-rf460-config-r1", ROTORLENS_BINDING_MANIFEST_ID);
+    EXPECT_EQ(25u, sizeof(ROTORLENS_BINDING_MANIFEST_ID) - 1);
+    EXPECT_EQ(90u, ROTORLENS_BINDING_MANIFEST_ROW_COUNT);
+    EXPECT_EQ(103u, sizeof(canonicalValues));
+
+    sha256Context_t valueHash;
+    uint8_t digest[SHA256_DIGEST_SIZE];
+    sha256Init(&valueHash);
+    sha256Update(&valueHash, canonicalValues, sizeof(canonicalValues));
+    sha256Final(&valueHash, digest);
+    expectDigestEquals(canonicalValuesDigest, digest);
+
+    hashWriterState_t writerState = {};
+    sha256Init(&writerState.sha256);
+    ASSERT_EQ(
+        ROTORLENS_BINDING_MANIFEST_OK,
+        rotorlensBindingManifestEncodeRowsV1(
+            canonicalValues, sizeof(canonicalValues), hashWriter, &writerState));
+
+    EXPECT_EQ(ROTORLENS_BINDING_MANIFEST_ROW_COUNT, writerState.callCount);
+    EXPECT_EQ(ROTORLENS_BINDING_MANIFEST_ROW_TLV_SIZE, writerState.acceptedLength);
+    EXPECT_EQ(ROTORLENS_BINDING_MANIFEST_MAX_ROW_WRITE_SIZE,
+        writerState.maximumWriteLength);
+
+    static const uint8_t expectedFirstRow[] = { 0x00, 0x01, 0x02, 0x01, 0x05 };
+    static const uint8_t expectedLastRow[] = { 0x00, 0x5a, 0x05, 0x02, 0xe5, 0x83 };
+    ASSERT_EQ(sizeof(expectedFirstRow), writerState.firstRowLength);
+    ASSERT_EQ(sizeof(expectedLastRow), writerState.lastRowLength);
+    EXPECT_EQ(0, memcmp(expectedFirstRow, writerState.firstRow, sizeof(expectedFirstRow)));
+    EXPECT_EQ(0, memcmp(expectedLastRow, writerState.lastRow, sizeof(expectedLastRow)));
+
+    sha256Final(&writerState.sha256, digest);
+    expectDigestEquals(rowTlvDigest, digest);
+}
+
+TEST(RotorlensBindingManifestUnittest, RejectsMalformedSnapshotsBeforeWriting)
+{
+    countWriterState_t writerState = {};
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_INVALID_ARGUMENT,
+        rotorlensBindingManifestEncodeRowsV1(
+            nullptr, sizeof(canonicalValues), countWriter, &writerState));
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_INVALID_ARGUMENT,
+        rotorlensBindingManifestEncodeRowsV1(
+            canonicalValues, sizeof(canonicalValues), nullptr, &writerState));
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_INVALID_LENGTH,
+        rotorlensBindingManifestEncodeRowsV1(
+            canonicalValues, sizeof(canonicalValues) - 1, countWriter, &writerState));
+    EXPECT_EQ(
+        ROTORLENS_BINDING_MANIFEST_INVALID_LENGTH,
+        rotorlensBindingManifestEncodeRowsV1(
+            canonicalValues, sizeof(canonicalValues) + 1, countWriter, &writerState));
+
+    EXPECT_EQ(0u, writerState.callCount);
+    EXPECT_EQ(0u, writerState.acceptedLength);
+}
+
+TEST(RotorlensBindingManifestUnittest, ValidatesEveryRowAgainstIndependentScalarOracle)
+{
+    for (size_t index = 0;
+         index < sizeof(scalarOracle) / sizeof(scalarOracle[0]);
+         index++) {
+        const scalarOracleRow_t &row = scalarOracle[index];
+        const unsigned fieldId = (unsigned)index + 1;
+        SCOPED_TRACE(fieldId);
+        uint8_t values[sizeof(canonicalValues)];
+
+        prepareScalarOracleValues(values, fieldId);
+        setScalarBe(values, row.offset, row.width, row.minimum);
+        expectAcceptedWithoutMutation(values);
+
+        prepareScalarOracleValues(values, fieldId);
+        setScalarBe(values, row.offset, row.width, row.maximum);
+        expectAcceptedWithoutMutation(values);
+
+        const int32_t storageMinimum = row.type == ROTORLENS_BINDING_SCALAR_I16
+            ? -32768
+            : 0;
+        const int32_t storageMaximum = row.type == ROTORLENS_BINDING_SCALAR_I16
+            ? 32767
+            : (row.width == 1 ? 255 : 65535);
+
+        if (row.minimum > storageMinimum) {
+            prepareScalarOracleValues(values, fieldId);
+            setScalarBe(values, row.offset, row.width, row.minimum - 1);
+            expectRejectedBeforeWriting(values);
+        }
+        if (row.maximum < storageMaximum) {
+            prepareScalarOracleValues(values, fieldId);
+            setScalarBe(values, row.offset, row.width, row.maximum + 1);
+            expectRejectedBeforeWriting(values);
+        }
+    }
+}
