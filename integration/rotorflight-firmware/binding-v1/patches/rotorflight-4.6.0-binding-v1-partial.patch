+static const uint8_t canonicalValuesDigest[SHA256_DIGEST_SIZE] = {
+    0xdf, 0xd9, 0x77, 0x53, 0x47, 0x0a, 0x7a, 0x9d,
+    0x73, 0x97, 0xdb, 0x40, 0xfb, 0x4b, 0x1c, 0x2a,
