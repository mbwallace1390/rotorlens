+
+#include "gtest/gtest.h"
+
+extern "C" {
+#include "config/rotorlens_config_mutation_epoch.h"
+}
+
+class RotorlensConfigMutationEpochTest : public ::testing::Test {
+protected:
+    void SetUp() override
+    {
+        rotorlensConfigMutationEpochTestReset();
+    }
+};
+
+TEST_F(RotorlensConfigMutationEpochTest, FreshStateIsStable)
+{
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), 0u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, NoOpMutationAdvancesAndCannotAba)
+{
+    uint32_t previousStableGeneration = rotorlensConfigMutationEpochGeneration();
+
+    for (uint32_t mutation = 0; mutation < 1024; mutation++) {
+        ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+        EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), previousStableGeneration + 1u);
+        EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 1u);
+
+        ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+        const uint32_t nextStableGeneration = rotorlensConfigMutationEpochGeneration();
+        EXPECT_EQ(nextStableGeneration, previousStableGeneration + 2u);
+        EXPECT_NE(nextStableGeneration, previousStableGeneration);
+        previousStableGeneration = nextStableGeneration;
+    }
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, NestedBoundariesChangeOnlyOuterGeneration)
+{
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), 1u);
+
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), 1u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 3u);
+
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), 1u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 1u);
+
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), 2u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, EveryRepresentableNestedDepthThenOverflowFaults)
+{
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    for (uint32_t depth = 2; depth <= static_cast<uint32_t>(UINT16_MAX); depth++) {
+        ASSERT_TRUE(rotorlensConfigMutationEpochBegin()) << "depth " << depth;
+    }
+
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), UINT16_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), 1u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, GenerationSaturatesWithoutWrapping)
+{
+    rotorlensConfigMutationEpochTestSeed(UINT32_MAX - 3u, 0);
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX - 2u);
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX - 1u);
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, LastActiveGenerationCanCloseButNotRestart)
+{
+    rotorlensConfigMutationEpochTestSeed(UINT32_MAX - 2u, 1);
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX - 1u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, UnmatchedEndLatchesPermanentFault)
+{
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, ImpossibleStateShapesLatchFault)
+{
+    rotorlensConfigMutationEpochTestSeed(2u, 1u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+
+    rotorlensConfigMutationEpochTestReset();
+    rotorlensConfigMutationEpochTestSeed(3u, 0u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, InterruptContextBeginLatchesFaultAndPreservesPrimask)
+{
+    rotorlensConfigMutationEpochTestSetInterruptContext(true);
+    rotorlensConfigMutationEpochTestSetPrimask(true);
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestPrimask());
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, InterruptContextEndLatchesFaultAndPreservesPrimask)
+{
+    rotorlensConfigMutationEpochTestSeed(1u, 1u);
+    rotorlensConfigMutationEpochTestSetInterruptContext(true);
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochTestPrimask());
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, StickyFaultSurvivesStaleTaskWritesAfterInterrupt)
+{
+    rotorlensConfigMutationEpochTestClearInstrumentation();
+    rotorlensConfigMutationEpochTestInjectInterruptFaultAfterStateRead();
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochTestStateWriteCount(), 8u);
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+
+    rotorlensConfigMutationEpochTestReset();
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    rotorlensConfigMutationEpochTestClearInstrumentation();
+    rotorlensConfigMutationEpochTestInjectInterruptFaultAfterStateRead();
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochTestStateWriteCount(), 8u);
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestDepth(), 0u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochBegin());
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, TaskCallsPreserveInitiallyDisabledPrimask)
+{
+    rotorlensConfigMutationEpochTestSetPrimask(true);
+
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestPrimask());
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestPrimask());
+
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestPrimask());
+    EXPECT_EQ(rotorlensConfigMutationEpochGeneration(), UINT32_MAX);
+}
+
+TEST_F(RotorlensConfigMutationEpochTest, StateWritesAreMaskedAndPublished)
+{
+    rotorlensConfigMutationEpochTestClearInstrumentation();
+    ASSERT_TRUE(rotorlensConfigMutationEpochBegin());
+    EXPECT_EQ(rotorlensConfigMutationEpochTestStateWriteCount(), 2u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestBarrierCount(), 1u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochTestHadUnprotectedStateWrite());
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestLastStateWriteWasPublished());
+
+    rotorlensConfigMutationEpochTestClearInstrumentation();
+    ASSERT_TRUE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochTestStateWriteCount(), 2u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestBarrierCount(), 2u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochTestHadUnprotectedStateWrite());
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestLastStateWriteWasPublished());
+
+    rotorlensConfigMutationEpochTestClearInstrumentation();
+    EXPECT_FALSE(rotorlensConfigMutationEpochEnd());
+    EXPECT_EQ(rotorlensConfigMutationEpochTestStateWriteCount(), 3u);
+    EXPECT_EQ(rotorlensConfigMutationEpochTestBarrierCount(), 2u);
+    EXPECT_FALSE(rotorlensConfigMutationEpochTestHadUnprotectedStateWrite());
+    EXPECT_TRUE(rotorlensConfigMutationEpochTestLastStateWriteWasPublished());
+}
