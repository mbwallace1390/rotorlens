+    { 200, 100, 100 },
+};
+
+_Static_assert(
+    sizeof(rateLimits) / sizeof(rateLimits[0]) == 6,
+    "RotorLens rates type limit count mismatch");
+
+enum {
+    VALUE_OFFSET_RATES_TYPE = 0,
+    VALUE_OFFSET_GOV_MODE = 41,
+    VALUE_OFFSET_GOV_THROTTLE_TYPE = 42,
+    VALUE_OFFSET_GOV_HANDOVER_THROTTLE = 55,
+    VALUE_OFFSET_GOV_IDLE_THROTTLE = 56,
+    VALUE_OFFSET_GOV_AUTO_THROTTLE = 57,
+    VALUE_OFFSET_GOV_FIRST_FLAG = 72,
+    VALUE_OFFSET_GOV_LAST_FLAG = 75,
+    VALUE_OFFSET_GOV_MAX_THROTTLE = 92,
+    VALUE_OFFSET_GOV_MIN_THROTTLE = 93,
+    VALUE_OFFSET_MIXER_SC_MIN = 97,
+    VALUE_OFFSET_MIXER_SC_MAX = 99,
+};
+
+static bool crossFieldsValid(const uint8_t *values)
+{
+    static const uint8_t rateAxisOffsets[] = { 1, 7, 13 };
+    const uint8_t ratesType = values[VALUE_OFFSET_RATES_TYPE];
+    const rateLimits_t *limits = &rateLimits[ratesType - 1];
+    for (size_t index = 0;
+         index < sizeof(rateAxisOffsets) / sizeof(rateAxisOffsets[0]);
+         index++) {
+        const size_t offset = rateAxisOffsets[index];
+        if (values[offset] > limits->rcRate ||
+            values[offset + 1] > limits->expo ||
+            values[offset + 2] > limits->sRate) {
+            return false;
+        }
+    }
+
+    if (decodeScalar(values + VALUE_OFFSET_MIXER_SC_MIN,
+            ROTORLENS_BINDING_SCALAR_I16) >
+        decodeScalar(values + VALUE_OFFSET_MIXER_SC_MAX,
+            ROTORLENS_BINDING_SCALAR_I16)) {
+        return false;
+    }
+
+    const uint8_t mode = values[VALUE_OFFSET_GOV_MODE];
+    const uint8_t throttleType = values[VALUE_OFFSET_GOV_THROTTLE_TYPE];
+    const uint8_t handover = values[VALUE_OFFSET_GOV_HANDOVER_THROTTLE];
+    const uint8_t idle = values[VALUE_OFFSET_GOV_IDLE_THROTTLE];
+    const uint8_t automatic = values[VALUE_OFFSET_GOV_AUTO_THROTTLE];
+    const uint16_t handoverIdleLimit = (uint16_t)handover * 10u - 1u;
+    const uint8_t maximumIdle = handoverIdleLimit < 250u
+        ? (uint8_t)handoverIdleLimit
+        : 250u;
+
+    if ((mode < 3 && throttleType == 1) ||
+        idle > automatic || automatic > maximumIdle) {
+        return false;
+    }
+
+    /* Mode 0 skips governor profile validation in RF 4.6. */
+    if (mode == 1 || mode == 2) {
+        for (size_t offset = VALUE_OFFSET_GOV_FIRST_FLAG;
+             offset <= VALUE_OFFSET_GOV_LAST_FLAG;
+             offset++) {
+            if (values[offset] != 0) {
+                return false;
+            }
+        }
+    }
+
+    if (mode != 0) {
+        const uint8_t maximum = values[VALUE_OFFSET_GOV_MAX_THROTTLE];
+        const uint8_t minimum = values[VALUE_OFFSET_GOV_MIN_THROTTLE];
+        if (maximum < handover || minimum > maximum) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+static rotorlensBindingManifestResult_e validateValues(
+    const uint8_t *values,
+    size_t valueLength)
+{
+    if (values == NULL) {
+        return ROTORLENS_BINDING_MANIFEST_INVALID_ARGUMENT;
+    }
+    if (valueLength != ROTORLENS_BINDING_MANIFEST_VALUE_SIZE) {
+        return ROTORLENS_BINDING_MANIFEST_INVALID_LENGTH;
+    }
+
+    size_t valueOffset = 0;
+    for (size_t index = 0; index < ROTORLENS_BINDING_MANIFEST_ROW_COUNT; index++) {
+        const uint8_t domainId = fieldDomains[index];
+        if (domainId >= FIELD_DOMAIN_COUNT) {
+            return ROTORLENS_BINDING_MANIFEST_INVALID_VALUE;
+        }
+        const fieldDomain_t *domain = &fieldDomainTable[domainId];
+        const uint8_t type = domain->type;
+        const uint8_t width = scalarWidth(type);
+        if (width == 0 || valueOffset > valueLength || width > valueLength - valueOffset) {
+            return ROTORLENS_BINDING_MANIFEST_INVALID_VALUE;
+        }
+        const int32_t value = decodeScalar(values + valueOffset, type);
+        if (value < (int32_t)domain->minimum || value > (int32_t)domain->maximum) {
+            return ROTORLENS_BINDING_MANIFEST_INVALID_VALUE;
+        }
+        valueOffset += width;
+    }
+
+    if (valueOffset != valueLength || !crossFieldsValid(values)) {
+        return ROTORLENS_BINDING_MANIFEST_INVALID_VALUE;
+    }
+    return ROTORLENS_BINDING_MANIFEST_OK;
+}
+
+rotorlensBindingManifestResult_e rotorlensBindingManifestEncodeRowsV1(
+    const uint8_t *values,
+    size_t valueLength,
+    rotorlensBindingManifestWriterFn writer,
+    void *writerContext)
+{
+    if (writer == NULL) {
+        return ROTORLENS_BINDING_MANIFEST_INVALID_ARGUMENT;
+    }
+
+    const rotorlensBindingManifestResult_e validationResult =
+        validateValues(values, valueLength);
+    if (validationResult != ROTORLENS_BINDING_MANIFEST_OK) {
+        return validationResult;
+    }
+
+    size_t valueOffset = 0;
+    for (size_t index = 0; index < ROTORLENS_BINDING_MANIFEST_ROW_COUNT; index++) {
+        const uint16_t fieldId = (uint16_t)(index + 1);
+        const uint8_t type = fieldDomainTable[fieldDomains[index]].type;
+        const uint8_t width = scalarWidth(type);
+        uint8_t row[ROTORLENS_BINDING_MANIFEST_MAX_ROW_WRITE_SIZE];
+        row[0] = (uint8_t)(fieldId >> 8);
+        row[1] = (uint8_t)fieldId;
+        row[2] = type;
+        row[3] = width;
+        memcpy(row + 4, values + valueOffset, width);
+
+        if (!writer(writerContext, row, 4 + width)) {
+            return ROTORLENS_BINDING_MANIFEST_WRITE_FAILED;
+        }
+        valueOffset += width;
+    }
+
+    return ROTORLENS_BINDING_MANIFEST_OK;
+}
