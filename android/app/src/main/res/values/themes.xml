<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The viewer paints its own dark surface. Matching it here stops the white
      flash between the activity appearing and the WebView drawing.
    -->
    <style name="Theme.RotorLens" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
</resources>
