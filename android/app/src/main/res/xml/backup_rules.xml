<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier: exclude every private file from cloud, adb and
     device-transfer backup. Android 12+ uses data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
