<?xml version="1.0" encoding="utf-8"?>
<!--
  The generated artwork already carries its dark field. Keeping it inside the
  68dp adaptive-icon safe area prevents round launchers from clipping the lens
  or rotor blades while still leaving Android room for its parallax animation.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <bitmap
            android:src="@drawable/ic_launcher_artwork"
            android:antialias="true"
            android:dither="true"
            android:filter="true"
            android:gravity="fill" />
    </item>
</layer-list>
