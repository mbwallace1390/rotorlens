    "test:emulator": "node scripts/run-emulator-tests.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "basic-ftp": "6.2.1",
    "chokidar": "4.0.3"
  }
}
